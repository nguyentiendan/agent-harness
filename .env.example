# ---------------------------------------------------------------------
# LLM provider keys — read by the LiteLLM gateway, NOT by the backend.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# OLLAMA_API_BASE=http://host.docker.internal:11434

# ---------------------------------------------------------------------
# LiteLLM Proxy (AI Gateway) — admin UI: http://localhost:4000/ui
#   login: admin / <LITELLM_MASTER_KEY>
# ---------------------------------------------------------------------
# Root credential for the gateway (also the Admin UI password).
LITELLM_MASTER_KEY=sk-change-me-master-key
# Encrypts provider keys stored in the gateway DB. Keep it stable: changing it
# makes already-stored credentials unreadable.
LITELLM_SALT_KEY=sk-change-me-salt-key
POSTGRES_PASSWORD=litellm

# Virtual key the backend uses to call the gateway. Create one per user/team in
# the UI (Virtual Keys -> Create) for real per-user audit trails. Leave empty to
# fall back to the master key.
LITELLM_VIRTUAL_KEY=

# On Linux, set these to your host `id -u` / `id -g` so the unprivileged
# backend container can write ./workspace_data and ./data.
# HARNESS_UID=1000
# HARNESS_GID=1000

# ---------------------------------------------------------------------
# Harness
# ---------------------------------------------------------------------
# Optional: path to the harness config file (defaults to config.yaml).
# HARNESS_CONFIG=config.yaml
# Optional: point the backend at the gateway (set automatically by compose).
# LITELLM_PROXY_URL=http://localhost:4000

# Platform identity database (separate from LiteLLM)
PLATFORM_DB_PASSWORD=replace-with-a-random-password
APP_ORIGIN=http://localhost:3000
